ContainerLogV2
| where PodName startswith 'pcr-data'
| where TimeGenerated > ago(14d)
| where ContainerName == 'springboot-app'
| where LogMessage contains 'HearingResultedServiceBusConsumer received channel:servicebus'
| make-series HearingIds = count() default=0
    on TimeGenerated
    from ago(14d) to now()
    step 1d
| render columnchart
