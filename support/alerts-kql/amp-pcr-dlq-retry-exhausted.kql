ContainerLogV2
| where PodName startswith "pcr-data"
| where ContainerName == "springboot-app"
| where LogMessage contains "processMessage exhausted after"
| extend LogJson = parse_json(LogMessage)
| project TimeGenerated, Level = tostring(LogJson.level), CorrId = tostring(split(tostring(LogJson["X-Correlation-Id"]), "-")[-1]), Message = tostring(LogJson.message)
| order by TimeGenerated asc
